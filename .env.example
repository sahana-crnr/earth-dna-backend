# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=local
PORT=1234
API_PREFIX=api/v1

# Backend API base URL (for password-reset links)
BACKEND_URL=http://localhost:1234

# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=earth_dna
DB_SYNC=true           # true for local only — always false in staging/production
DB_LOGGING=true
DB_SSL=false           # true when connecting to RDS from outside the VPC (e.g. local migration:run against prod)

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-this-with-a-strong-random-secret
JWT_EXPIRES_IN=1h

# ─── Mail ─────────────────────────────────────────────────────────────────────
MAIL_FROM_NAME=Earth DNA
MAIL_DRY_RUN=true       # true = log reset link to console, no real email sent
RESET_PASSWORD_TOKEN_EXPIRY_MINUTES=15
# Global rate-limit default applied to EVERY route. Keep this generous - strict
# per-route limits are declared with @Throttle() in auth.controller.ts
# (forgot-password 3/min, login 10/min, google 20/min).
# NOTE: behind a load balancer you must also set `trust proxy`, or every request
# appears to come from the LB and all users share one rate-limit bucket.
THROTTLE_LIMIT=100
THROTTLE_TTL_MS=60000

# ─── AWS SES (sandbox: verify sender AND recipient in SES console, us-east-1) ─
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_FROM_EMAIL=noreply@earth-dna.com

# ─── Google Sign-In ───────────────────────────────────────────────────────────
# Comma-separated OAuth client IDs accepted as the "aud" claim of an incoming
# Google ID token. Values come from the Firebase project's config files
# (android/app/google-services.json and ios/Runner/GoogleService-Info.plist).
# Use the Web client ID plus each iOS client ID; Android client IDs are NOT
# audiences - on Android the token's aud is the serverClientId (the Web client).
# If unset, POST /auth/google fails closed and rejects every token.
GOOGLE_CLIENT_IDS=
