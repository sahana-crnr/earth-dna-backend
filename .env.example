# Earth DNA backend — every key the service reads, with its default.
# Generated by tools/gen_env_example.py from app/core/settings.py; do not edit by hand.
#
# Deployed environments do not use this file: the ECS task definition injects
# the whole per-environment secret as APP_CONFIG (one JSON object with these
# keys) plus APP_ENV. Locally, copy to .env and fill the blanks.
#
# Required (no default): JWT_SECRET (>= 32 chars). Generate:
#   python -c "import secrets; print(secrets.token_hex(32))"

APP_ENV=local
PORT=1234
API_PREFIX=api/v1
BACKEND_URL=http://localhost:1234
CORS_ORIGINS=
TRUSTED_PROXY_IPS=
LOG_LEVEL=INFO
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=earth_dna
DB_SSL=false
DB_LOGGING=false
DB_SYNC=false
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISABLE=false
MAIL_FROM_NAME=Earth DNA
MAIL_DRY_RUN=false
RESET_PASSWORD_TOKEN_EXPIRY_MINUTES=15
AWS_SES_FROM_EMAIL=
THROTTLE_LIMIT=100
THROTTLE_TTL_MS=60000
AWS_REGION=us-east-1
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
