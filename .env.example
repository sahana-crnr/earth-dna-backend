# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=local
PORT=1234
API_PREFIX=api/v1

# Backend API base URL (for password-reset links)
BACKEND_URL=http://localhost:1234

# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=earth_dna
DB_SYNC=true           # true for local only — always false in staging/production
DB_LOGGING=true
DB_SSL=false           # true when connecting to RDS from outside the VPC (e.g. local migration:run against prod)

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-this-with-a-strong-random-secret
JWT_EXPIRES_IN=24h
# Refresh token lifetime (opaque token stored hashed in the refresh_tokens table)
REFRESH_TOKEN_EXPIRES_IN=30d

# ─── Admin (F7) ───────────────────────────────────────────────────────────────
# The single ADMIN account. Synced into the users table on every boot by
# AdminBootstrapService; the admin then signs in through the normal
# POST /api/v1/auth/login and gets `role: "ADMIN"` in the response and the JWT.
#
# ENV IS THE SOURCE OF TRUTH (when the credentials are usable)
#   - The ADMIN_EMAIL account is created (local, bcrypt hash) or promoted.
#     Promoting an existing account signs it out of every device, and
#     POST /auth/register refuses ADMIN_EMAIL (as "already exists"), so nobody
#     can pre-register the address and inherit the role.
#   - Any other ADMIN row is demoted to USER, so changing ADMIN_EMAIL MOVES the
#     role rather than adding a second admin.
#   - Changing ADMIN_PASSWORD rehashes it on the next boot and signs the admin
#     out of every device (refresh tokens; an access token already issued
#     lives until JWT_EXPIRES_IN). A password reset via /auth/forgot-password
#     is overwritten again at the next boot.
#   - An ADMIN_EMAIL that already belongs to a Google/Facebook/Apple account is
#     refused (logged), never taken over.
#
# WHERE IT IS SET PER ENVIRONMENT
#   local  : this .env file
#   dev2   : AWS Secrets Manager, secret `earthdna/be/jwt-ue1-dev2`, JSON keys
#            ADMIN_EMAIL and ADMIN_PASSWORD, mapped in the ECS task
#            definition's `secrets[]` array (valueFrom, NOT environment[]).
#
# If either is unset, or ADMIN_PASSWORD is shorter than 12 characters, the
# bootstrap logs a warning and changes NOTHING: an existing admin keeps the
# role, so a broken secret during a deploy cannot lock everyone out.
#
# To remove the admin on purpose, set ADMIN_DISABLE=true: every admin is
# demoted on the next boot and /admin/* answers 403 FORBIDDEN_ROLE. The rest
# of the API is unaffected.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISABLE=false

# ─── Mail ─────────────────────────────────────────────────────────────────────
MAIL_FROM_NAME=Earth DNA
MAIL_DRY_RUN=true       # true = log reset link to console, no real email sent
RESET_PASSWORD_TOKEN_EXPIRY_MINUTES=15
# Global rate-limit default applied to EVERY route. Keep this generous - strict
# per-route limits are declared with @Throttle() in auth.controller.ts
# (forgot-password 3/min, login 10/min, google 20/min).
# NOTE: behind a load balancer you must also set `trust proxy`, or every request
# appears to come from the LB and all users share one rate-limit bucket.
THROTTLE_LIMIT=100
THROTTLE_TTL_MS=60000

# ─── AWS SES (sandbox: verify sender AND recipient in SES console, us-east-1) ─
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_FROM_EMAIL=noreply@earth-dna.com

# ─── Google Sign-In ───────────────────────────────────────────────────────────
# Comma-separated OAuth client IDs accepted as the "aud" claim of an incoming
# Google ID token. Used by POST /api/v1/auth/google.
#
# WHERE THE VALUES COME FROM
#   Firebase project `earthdna-app`. They are in the app config files:
#     earth-dna-F.E/android/app/google-services.json  -> oauth_client[] (Web = client_type 3)
#     earth-dna-F.E/ios/Runner/GoogleService-Info.plist -> CLIENT_ID
#   Use the WEB client ID plus each iOS client ID. Android client IDs are NOT
#   valid audiences: on Android the token's aud is the serverClientId, which is
#   the Web client.
#
# WHERE IT IS SET PER ENVIRONMENT
#   local  : this .env file
#   dev2   : AWS Secrets Manager, secret `earthdna/be/jwt-ue1-dev2`, JSON key
#            GOOGLE_CLIENT_IDS. It reaches the container via the ECS task
#            definition's `secrets[]` array:
#              { "name": "GOOGLE_CLIENT_IDS",
#                "valueFrom": "<secret-arn>:GOOGLE_CLIENT_IDS::" }
#            Adding the key to the secret is NOT enough on its own - the task
#            definition must map it, and the ECS service must point at that
#            revision, or the deploy workflow will inherit the older one.
#
# NOT A SECRET: OAuth client IDs are public (they ship inside the mobile app).
# Stored in Secrets Manager only to keep dev2 config in one place.
#
# If unset or empty, POST /auth/google FAILS CLOSED and rejects every token.
GOOGLE_CLIENT_IDS=

# ─── Facebook Login ───────────────────────────────────────────────────────────
# Used by POST /api/v1/auth/facebook. The app sends ONE field, accessToken, whose
# shape depends on the platform:
#   iOS     : Limited Login OIDC token (a JWT). Verified offline against Facebook's
#             JWKS; "aud" must equal FACEBOOK_APP_ID.
#   Android : classic opaque access token (starts "EAA"). Verified by calling
#             Graph API debug_token with the app access token APP_ID|APP_SECRET,
#             then /me with appsecret_proof.
#
# WHERE THE VALUES COME FROM
#   developers.facebook.com -> the Earth DNA app -> App settings -> Basic.
#   App ID is public (it ships inside the mobile app). App Secret is a REAL
#   SECRET: never commit it, never log it, never put it in the app.
#
# WHERE IT IS SET PER ENVIRONMENT
#   local  : this .env file
#   dev2   : AWS Secrets Manager, secret `earthdna/be/jwt-ue1-dev2`, JSON keys
#            FACEBOOK_APP_ID and FACEBOOK_APP_SECRET, mapped in the ECS task
#            definition's `secrets[]` array with valueFrom (NOT environment[]).
#
# Empty FACEBOOK_APP_ID  -> endpoint FAILS CLOSED, every token rejected.
# Empty FACEBOOK_APP_SECRET -> only the Android (opaque) path is rejected.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ─── Sign in with Apple ───────────────────────────────────────────────────────
# Comma-separated values accepted as the "aud" claim of an Apple identity token.
# For the native iOS app this is the BUNDLE ID. Used by POST /api/v1/auth/apple.
# Apple's public keys are fetched from https://appleid.apple.com/auth/keys - no
# secret, no key file, nothing to download from the Apple developer portal.
#
# The bundle ID is still the placeholder com.example.earthDnaApp (tracker T5).
# When it changes, ADD the new one here (keep the old one until every installed
# build has updated) - this is why it is a list.
#
# dev2: same Secrets Manager secret as above, JSON key APPLE_CLIENT_IDS, via the
# task definition secrets[] array. Not actually a secret; kept there so all dev2
# config lives in one place.
#
# If unset or empty, POST /auth/apple FAILS CLOSED and rejects every token.
APPLE_CLIENT_IDS=com.example.earthDnaApp

# ─── Scan photo storage (F1) ─────────────────────────────────────────────────
# Private bucket for scan photos. Not a secret. Required for /scans routes; when
# unset those routes answer 503 STORAGE_NOT_CONFIGURED and the rest of the API
# keeps working.
#   local : earthdna-shoe-photos-local (LocalStack, see ../local-infra)
#   dev2  : earthdna-shoe-photos-ue1-dev2 — key SHOE_PHOTOS_BUCKET in the same Secrets
#           Manager secret as GOOGLE_CLIENT_IDS, wired through task definition secrets[]
SHOE_PHOTOS_BUCKET=earthdna-shoe-photos-local
# Only for LocalStack (../local-infra). NEVER set on dev/prod — real S3 with the
# task-role credentials is used when these are unset.
# STORAGE_S3_ENDPOINT=http://localhost:4567
# STORAGE_S3_FORCE_PATH_STYLE=true
# Only when the backend runs inside Docker: the browser-reachable LocalStack
# address used for signed thumbnail URLs (backend itself uses STORAGE_S3_ENDPOINT).
# STORAGE_S3_PUBLIC_ENDPOINT=http://localhost:4567
# Credentials for the local emulator only (MinIO in local-infra); ignored when
# STORAGE_S3_ENDPOINT is unset. Defaults: test / test.
# STORAGE_S3_ACCESS_KEY=earthdna
# STORAGE_S3_SECRET_KEY=earthdna-local

# ─── Scan session rules (F1) — all optional, defaults shown ─────────────────
SCAN_MAX_SHOES=4                 # shoes per session (camera)
SCAN_ALBUM_MAX_SHOES=3           # shoes per album batch (Figma: 3 pairs)
SCAN_ALBUM_MAX_PHOTOS=12         # photos per album batch
SCAN_PHOTO_MAX_BYTES=1048576     # 1 MB per photo
SCAN_PHOTO_ALLOWED_TYPES=jpeg,png   # jpg = jpeg; detected from file bytes
SCAN_MAX_OPEN_DRAFTS=0           # 0 = unlimited
SCAN_DELETE_OBJECTS_ON_REMOVE=true
SCAN_DRAFT_ABANDON_DAYS=30
SCAN_PHOTO_URL_TTL_SECONDS=900   # signed thumbnail URL lifetime

# ─── Identification results (F2) — all optional, defaults shown ──────────────
# Both fail soft: a typo falls back to the default rather than to 0, so a bad
# value can never reject every result submission.
SCAN_RESULT_MAX_CANDIDATES=3     # ranked candidates stored per result ("top-3")
SCAN_RESULT_RAW_MAX_BYTES=8192   # cap on the free-form `raw` ShoeDNA blob
# Server-side ShoeDNA fallback (POST …/analyze). The endpoint and the name of
# its credential are NOT env: an admin sets them in /admin/integrations (F7).
# Whoever signs the AWS calls needs secretsmanager:GetSecretValue on that one
# secret (not earthdna/be/*, which also holds the JWT/admin credentials). The
# SDK takes AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY before the ECS task role,
# so on dev2 that is the IAM user earth-dna-be-ses-ue1-dev2, not the task role
# (a task-role grant alone → 503 INFERENCE_CREDENTIAL_UNAVAILABLE).
#   dev2: secret earthdna/be/shoedna-api-key-ue1-dev2 (authRef), readable via
#         inline policy shoedna-secret-read-ue1-dev2 on that IAM user.
SCAN_INFERENCE_TIMEOUT_MS=25000  # abort the ShoeDNA call after this; the app gets 504 INFERENCE_TIMEOUT

# ─── Review + My Shoes (F3) — all optional, defaults shown ──────────────────
SHOE_VALUE_PLACEHOLDER=true      # Figma placeholder value / recommendation until ValueLens exists (CO2e dropped)
SHOE_THUMBNAIL_VIEW=right        # which captured view becomes the My Shoes thumbnail

# ─── Catalog (F3) ────────────────────────────────────────────────────────────
CATALOG_MUTED_ENDPOINTS=          # comma list among models,colours,categories,options → 404 ENDPOINT_MUTED (empty since F5: categories = shoe types)
CATALOG_LIST_MAX=500
# Source database for `npm run catalog:seed` ONLY (read-only; the API never
# connects to it). Leave unset on servers.
# CATALOG_SOURCE_DB_HOST=
# CATALOG_SOURCE_DB_PORT=5432
# CATALOG_SOURCE_DB_USERNAME=
# CATALOG_SOURCE_DB_PASSWORD=
# CATALOG_SOURCE_DB_NAME=
# CATALOG_SOURCE_DB_SCHEMA=
# CATALOG_SOURCE_DB_SSL=true

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma list of browser origins allowed to call the API. Unset = any origin
# (behaviour before this setting existed; mobile apps send no Origin header).
# Local test UI: http://localhost:8088
CORS_ORIGINS=

# ─── F5 My Shoes profile + manage ───────────────────────────────────────────
SHOE_MAX_PHOTOS=8                 # photos per shoe, scan views included (Figma "Photos (4/8)")
SHOE_PHOTO_URL_TTL_SECONDS=3600   # signed URL lifetime on the profile and the public share page
# SHARE_BASE_URL=https://earthdna.app   # prefix of share links (…/s/{token}); unset = the request's API base
SHARE_TOKEN_RANDOM_CHARS=12       # random part of a share token (CSPRNG, ~59 bits)
SHOE_UPLOAD_PREFIX=shoes          # S3 key prefix for Edit-screen uploads: shoes/{userId}/{shoeId}/{photoId}.{ext}
