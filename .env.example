# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database (matches docker-compose.yml defaults)
DB_HOST=localhost
DB_PORT=5433           # 5433 — avoids conflict with local Homebrew Postgres on 5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=earth_dna

# TypeORM
DB_SYNC=true           # true for local dev only — always false in staging/production
DB_LOGGING=true

# JWT — generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-this-with-a-strong-random-secret
JWT_EXPIRES_IN=7d
